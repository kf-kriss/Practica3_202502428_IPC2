<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Veterinaria Patitas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <a class="site-name" asp-controller="Mascotas" asp-action="Index">Veterinaria Patitas</a>
            <nav aria-label="Navegación principal">
                <a asp-controller="Mascotas" asp-action="Index">Mascotas</a>
                <a asp-controller="Mascotas" asp-action="Dosis">Calcular dosis</a>
            </nav>
        </div>
    </header>
    <main class="container main-content">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <p class="notice" role="status">@mensaje</p>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">Práctica 3 de IPC2 · Los datos se conservan mientras la aplicación está en ejecución.</div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
