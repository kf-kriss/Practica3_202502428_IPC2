@model DosisViewModel
@{
    ViewData["Title"] = "Calcular dosis";
}
<a class="back-link" asp-action="Index">← Volver a mascotas</a>
<section class="page-heading">
    <p class="eyebrow">HERRAMIENTA DE CÁLCULO</p>
    <h1>Calcula una dosis</h1>
    <p>Busca a la mascota por su código y escribe la dosis indicada por kilogramo.</p>
</section>
<form asp-action="Dosis" method="post" class="form-card compact-card">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field">
        <label asp-for="Codigo">Código de la mascota</label>
        <input asp-for="Codigo" placeholder="Ej. No-00001" autocomplete="off" />
        <span asp-validation-for="Codigo" class="field-error"></span>
        <small>El código aparece en el listado y en la ficha de la mascota.</small>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.NombreMascota))
    {
        <p class="selected-pet">Mascota seleccionada: <strong>@Model.NombreMascota</strong></p>
    }
    <div class="field">
        <label asp-for="DosisPorKg"></label>
        <input asp-for="DosisPorKg" type="number" min="0" step="0.01" placeholder="Ej. 2.5" />
        <span asp-validation-for="DosisPorKg" class="field-error"></span>
    </div>
    <div class="form-actions">
        <button class="button" type="submit">Calcular dosis</button>
    </div>
    @if (Model.DosisCalculada is double dosis)
    {
        <div class="result-card" role="status">
            <span>Resultado para @Model.NombreMascota</span>
            <strong>@dosis.ToString("0.##") mg</strong>
            <p>El cálculo aplica automáticamente el factor correspondiente a la especie.</p>
        </div>
    }
    <p class="medical-note">Este cálculo es para la práctica y no sustituye la indicación de un profesional veterinario.</p>
</form>
