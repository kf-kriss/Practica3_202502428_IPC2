@model Mascota[]
@{
    ViewData["Title"] = "Mascotas";
}

<div class="list-heading">
    <div>
        <h1>Mascotas registradas</h1>
        <p>@Model.Length @(Model.Length == 1 ? "mascota" : "mascotas") en el sistema</p>
    </div>
    <a class="button" asp-action="Create">Registrar mascota</a>
</div>

<div class="table-wrap">
    <table class="pet-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Peso</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Length == 0)
            {
                <tr>
                    <td colspan="6" class="empty-row">
                        No hay mascotas registradas. Pulsa «Registrar mascota» para agregar la primera.
                    </td>
                </tr>
            }
            else
            {
                @foreach (Mascota mascota in Model)
                {
                    string especie = mascota switch
                    {
                        Perro => "Perro",
                        Gato => "Gato",
                        Ave => "Ave",
                        Tortuga => "Tortuga",
                        _ => "Mascota"
                    };
                    <tr>
                        <td>@mascota.Codigo</td>
                        <td><a class="table-link" asp-action="Details" asp-route-id="@mascota.Codigo">@mascota.Nombre</a></td>
                        <td>@especie</td>
                        <td>@mascota.Peso.ToString("0.##") kg</td>
                        <td>@(mascota.Enfermo ? "Enferma" : "Sana")</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@mascota.Codigo">Editar</a>
                                <a asp-action="Dosis" asp-route-especie="@especie" asp-route-peso="@mascota.Peso">Dosis</a>
                                <a asp-action="Delete" asp-route-id="@mascota.Codigo">Eliminar</a>
                                <form asp-action="CambiarEstado" asp-route-id="@mascota.Codigo" method="post">
                                    <button type="submit">Marcar @(mascota.Enfermo ? "sana" : "enferma")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
