@model MascotaFormViewModel
@{
    ViewData["Title"] = "Editar mascota";
    ViewData["SoloLecturaEspecie"] = true;
}
<a class="back-link" asp-action="Index">← Volver a mascotas</a>
<section class="page-heading">
    <p class="eyebrow">ACTUALIZAR FICHA</p>
    <h1>Edita los datos</h1>
    <p>El tipo de mascota no cambia al editar su ficha.</p>
</section>
<form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post" class="form-card">
    <partial name="_MascotaForm" model="Model" />
    <div class="form-actions">
        <a class="button button-secondary" asp-action="Index">Cancelar</a>
        <button class="button" type="submit">Guardar cambios</button>
    </div>
</form>
